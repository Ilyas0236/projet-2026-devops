# Copier ce fichier vers .env avant de lancer docker compose up
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=wydad
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST_PORT=5433

# --- JWT (OBLIGATOIRE) : générer avec openssl rand -base64 64 ---
JWT_SECRET=

# --- Mot de passe du compte admin créé au premier démarrage (OBLIGATOIRE) ---
# Utilisé uniquement si la base est vide, pour créer admin@wac.ma
ADMIN_SEED_PASSWORD=

# --- CORS : origines du frontend séparées par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Secret inter-services (OBLIGATOIRE) : générer avec openssl rand -base64 32 ---
# Utilisé par shop-service et ticket-service pour appeler notification-service
INTERNAL_SECRET=

# --- Redis ---
REDIS_HOST_PORT=6379

# --- pgAdmin ---
PGADMIN_EMAIL=admin@wydad.ma
PGADMIN_PASSWORD=changez-moi
PGADMIN_HOST_PORT=5050

# --- API Gateway ---
GATEWAY_HOST_PORT=8080
