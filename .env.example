# Copier ce fichier vers .env avant de lancer docker compose up
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=wydad
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST_PORT=5433

# --- JWT (OBLIGATOIRE) : générer avec openssl rand -base64 64 ---
JWT_SECRET=

# --- CORS : origines du frontend séparées par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Redis ---
REDIS_HOST_PORT=6379

# --- pgAdmin ---
PGADMIN_EMAIL=admin@wydad.ma
PGADMIN_PASSWORD=changez-moi
PGADMIN_HOST_PORT=5050

# --- API Gateway ---
GATEWAY_HOST_PORT=8080
