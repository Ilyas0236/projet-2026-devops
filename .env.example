# =================================================================
# Wydad Digital - Environment Variables Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
# =================================================================

# --- PostgreSQL (Infrastructure) ---
POSTGRES_USER=wydad
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST_PORT=5433

# --- Security & JWT (MANDATORY) ---
# Generate using: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret_64_bytes_minimum_length_here

# --- Admin Initial Account (MANDATORY) ---
# Automatically seeds default administrator on first boot (admin@wac.ma)
ADMIN_SEED_PASSWORD=YourStrongAdminPassword2026!

# --- Inter-Service HMAC Secret (MANDATORY) ---
# Shared secret for direct microservice-to-microservice authentication
# Generate using: openssl rand -base64 32
INTERNAL_SECRET=your_base64_internal_service_secret_32_bytes_here

# --- CORS Configuration ---
# Comma-separated list of allowed origins for the web client
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Redis (Cache & Session) ---
REDIS_HOST_PORT=6379

# --- pgAdmin (Database Administration GUI) ---
PGADMIN_EMAIL=admin@wydad.ma
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_HOST_PORT=5050

# --- Ports & Exposure ---
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=4200

# --- Optional Third-Party Services (Stubs enabled if omitted) ---
# Cloudinary (Media storage & KYC documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit (Real-time Video / Audio calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
