@startuml classes-messagerie
' ============================================================
' Diagramme de classes — DOMAINE MESSAGERIE
' Source : communication-service/src/main/java/.../model/**
' ============================================================
' Conventions UML 2.5 :
'   * classes JPA reelles avec attributs principaux
'   * sportType/category en STRING (decouplage inter-services)
'   * 3 entites : Message (1-to-1), TeamMessage (groupe), Announcement
' ============================================================

left to right direction
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
  ArrowColor #1E3A8A
  FontSize 11
}
skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #888888
}
skinparam enum {
  BackgroundColor #FFF8E1
  BorderColor #C79100
}
skinparam stereotypeCBackgroundColor #E8F0FE
skinparam shadowing false
hide circle
hide methods

' ============================================================
' ENTITE — MESSAGE 1-TO-1 (B.5, V2.3 photos, V2.4 batch)
' ============================================================
class Message <<Entity>> {
  -id : Long
  -senderUserId : Long {not null}
  -senderName : String
  -senderRole : String {not null}
  -recipientUserId : Long {not null}
  -content : String {max 500}
  -readAt : LocalDateTime
  -attachmentPublicId : String
  -attachmentSecureUrl : String
  -attachmentResourceType : String
  -attachmentFileName : String
  -attachmentSizeBytes : Long
  -createdAt : LocalDateTime
}

note right of Message
  **B.5 — Messagerie 1-to-1**
  ─────────────────────────
  IDOR strict : JOUEUR ↔ STAFF/ENTRAINEUR
  MEME categorie (sameGroup)
  V2.3 : photo via Cloudinary (5 champs)
  V2.4 : send-batch 1..50 destinataires
  (fan-out applicatif, 0 migration BDD)
end note

' ============================================================
' ENTITE — TEAM MESSAGE (Phase 4 groupe, V2.5 photos)
' ============================================================
class TeamMessage <<Entity>> {
  -id : Long
  -sportType : String {not null}
  -category : String {not null}
  -senderUserId : Long {not null}
  -senderName : String
  -senderRole : String {not null}
  -content : String {max 500}
  -mediaUrl : String
  -mediaType : String
  -createdAt : LocalDateTime
}

note right of TeamMessage
  **Phase 4 — Team-chat WhatsApp-like**
  ──────────────────────────────────
  Groupe = (sportType, category)
  adhesion DEDUITE du roster (sports-service)
  → un membre parti n'a plus accès
  V2.5 : photos (mediaUrl + mediaType)
  via POST /messages ou /media multipart
end note

' ============================================================
' ENTITE — ANNOUNCEMENT (B.5 annonces staff/admin)
' ============================================================
class Announcement <<Entity>> {
  -id : Long
  -title : String {max 150}
  -body : String {max 2000}
  -sportType : String {nullable}
  -category : String {nullable}
  -createdByStaffId : Long {not null}
  -createdByName : String
  -createdAt : LocalDateTime
}

note right of Announcement
  **B.5 — Annonces ciblées**
  ───────────────────────
  sportType/category nuls = tout le club
  sinon filtré serveur selon
  la categorie de l'utilisateur
  STAFF + ADMIN émetteurs
end note

' ============================================================
' FK LOGIQUES (vers auth-service User)
' ============================================================
note bottom of Message
  **FK logique** : senderUserId / recipientUserId
  pointent vers auth-service User
  (pas de JPA cross-service)
end note

@enduml
